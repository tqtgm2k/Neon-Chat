# ── Server ──
PORT=3000
# Khóa bí mật ký token & hash mật khẩu.
# QUAN TRỌNG: trên Railway phải đặt đúng giá trị cũ để mật khẩu user hiện tại còn đăng nhập được.
JWT_SECRET=
# ── MySQL ──
MYSQLHOST=
MYSQLPORT=3306
MYSQLUSER=
MYSQLPASSWORD=
MYSQLDATABASE=

# ── Backblaze B2 (file sharing) ──
B2_KEY_ID=
B2_APP_KEY=
B2_BUCKET=
B2_ENDPOINT=s3.us-east-005.backblazeb2.com

# ── ElevenLabs TTS cho Game Show ──
# Có thể nhập API key/ID giọng nói trong giao diện. Biến này là fallback nếu muốn cấu hình ở server.
ELEVENLABS_API_KEY=
ELEVENLABS_MODEL_ID=eleven_flash_v2_5

# ── Mistral AI cho Game Show ──
# Có thể nhập key trong giao diện. Biến này là fallback nếu muốn cấu hình ở server.
MISTRAL_API_KEY=
